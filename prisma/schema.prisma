generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  SCRIPT_ANALYZING
  PLANNING
  GENERATING
  ASSEMBLING
  IN_PROGRESS
  COMPLETE
  PUBLISHED
  ARCHIVED
}

enum AssetType {
  MUSIC
  VOICE
  IMAGE
  VIDEO
  AUDIO
  AI_GENERATED
  FOOTAGE
}

enum LicenseType {
  CC0
  CC_BY
  CC_BY_SA
  CC_BY_NC
  PIXABAY
  ROYALTY_FREE
  ELEVENLABS_COMMERCIAL
  RUNWAY_COMMERCIAL
  LICENSED
  GENERATED
  UNKNOWN
}

enum JobType {
  SCRIPT_PARSE
  IMAGE_GENERATE
  VIDEO_GENERATE
  VOICE_GENERATE
  MUSIC_SELECT
  VIDEO_ASSEMBLE
  CONTENT_ID_CHECK
  SCENE_GENERATE
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
  CANCELLED
  PAUSED
}

enum SceneStatus {
  DRAFT
  ASSETS_READY
  RENDERED
}

enum ShotStatus {
  DRAFT
  GENERATING
  COMPLETE
  FAILED
  NEEDS_REVIEW
}

enum DialogueStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Key-value store for runtime configuration (API keys etc.) saved via the Settings UI.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id                   String   @id @default("singleton")
  defaultVideoProvider String   @default("runway")
  updatedAt            DateTime @updatedAt
}

// Encrypted provider API keys saved via the Settings UI.
model ProviderKey {
  id           String    @id @default(cuid())
  provider     String    @unique
  encryptedKey String    @db.Text
  isVerified   Boolean   @default(false)
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model StorageSetting {
  id              String   @id @default(cuid())
  localRootPath   String?
  useLocalStorage Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model Project {
  id                       String        @id @default(cuid())
  name                     String
  status                   ProjectStatus @default(DRAFT)
  platform                 String? // youtube | tiktok | instagram | youtube_shorts
  thumbnailPath            String? // R2 key of selected thumbnail (denormalized for fast list queries)
  completedAt              DateTime?
  archivedAt               DateTime?
  // Style metadata (set at analysis time, used for insights)
  genre                    String?
  tone                     String?
  targetLength             String?
  projectSlug              String?       @unique
  storageFolderInitialized Boolean       @default(false)
  // Theme
  themeId                  String?
  theme                    Theme?        @relation(fields: [themeId], references: [id])
  themeMode                String        @default("single")
  themeOverrideMode        String        @default("fill_empty")
  productionMode           String        @default("character_driven")
  variantCount             Int           @default(1)
  videoProvider            String        @default("runway")
  videoAspectRatio         String        @default("16:9")
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  scripts           Script[]
  assets            Asset[]
  jobs              Job[]
  scenes            Scene[]
  projectCharacters ProjectCharacter[]
  exports           Export[]
  transcription     Transcription?
  narratorProfile   NarratorProfile?
  visualSegments    VisualSegment[]
  scenePreviews     ScenePreview[]
  projectMusicTrack ProjectMusicTrack?
  runwayClips       RunwayClip[]
  assembledVideo    AssembledVideo?
  thumbnails        ProjectThumbnail[]
  posts             SocialPost[]
  versions          ProjectVersion[]
  costs             ProjectCost[]
  generationJob     GenerationJob?
}

model Character {
  id                   String                        @id @default(cuid())
  name                 String
  role                 String?
  age                  Int?
  gender               String?
  ethnicity            String?
  physicalDescription  String?                       @db.Text
  biography            String?                       @db.Text
  personality          String?                       @db.Text
  motivations          String?                       @db.Text
  fears                String?                       @db.Text
  quirks               String?                       @db.Text
  emotionalRange       String?
  gestureTendencies    String?                       @db.Text
  forbiddenChanges     String?                       @db.Text
  portraitPath         String?
  portraitPrompt       String?                       @db.Text
  portraitStyle        String?
  voiceId              String?
  voicePace            String?
  voiceAccent          String?
  voiceTone            String?
  voiceNotes           String?                       @db.Text
  isArchived           Boolean                       @default(false)
  tags                 String?
  generatedFromThemeId String?
  generatedFromTheme   Theme?                        @relation(fields: [generatedFromThemeId], references: [id])
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  projectCharacters    ProjectCharacter[]
  dialogueLines        DialogueLine[]
  portraitGenerations  CharacterPortraitGeneration[]

  @@index([generatedFromThemeId])
}

model ProjectCharacter {
  id               String    @id @default(cuid())
  characterId      String
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleInProject    String?
  scenesAppearedIn String?
  addedAt          DateTime  @default(now())

  @@unique([characterId, projectId])
  @@index([projectId])
  @@index([characterId])
}

model CharacterPortraitGeneration {
  id            String    @id @default(cuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  imagePath     String
  prompt        String    @db.Text
  style         String?
  flagged       Boolean   @default(false)
  flaggedReason String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([characterId])
}

model Script {
  id         String   @id @default(cuid())
  projectId  String
  content    String   @db.Text
  parsedData Json?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Asset {
  id String @id @default(cuid())

  // projectId is null for global library assets, set for project-specific assets
  projectId String?

  name                 String
  type                 AssetType
  sourceName           String
  sourceUrl            String?
  licenseType          LicenseType
  licenseUrl           String?
  licenseScreenshotUrl String?

  // Nullable = unknown/not yet verified
  commercialUse       Boolean?
  monetizationAllowed Boolean?

  attributionRequired Boolean @default(false)
  attributionText     String?

  // Content ID (music only)
  contentIdChecked Boolean @default(false)
  contentIdClear   Boolean @default(false)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  musicCues SceneMusicCue[]

  @@index([projectId])
  @@index([type])
}

model Job {
  id            String    @id @default(cuid())
  projectId     String
  type          JobType
  status        JobStatus @default(PENDING)
  progress      Int       @default(0)
  costSoFar     Float     @default(0)
  estimatedCost Float?
  error         String?   @db.Text

  // Checkpoint — stores { lastCompletedShotId, completedShotIds, config } for resume
  metadata       Json?
  totalShots     Int   @default(0)
  completedShots Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Scene {
  id               String      @id @default(cuid())
  projectId        String
  themeId          String?
  sceneNumber      Int
  title            String
  location         String?
  timeOfDay        String?
  status           SceneStatus @default(DRAFT)
  assembledPath    String?
  assembledBackend String?
  useProjectTheme  Boolean     @default(true)
  productionMode   String?
  firstImagePath    String?
  durationSeconds   Float?
  createdAt        DateTime    @default(now())

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  theme    Theme?         @relation(fields: [themeId], references: [id])
  shots    Shot[]
  musicCue SceneMusicCue?
  previews ScenePreview[]

  @@index([themeId])
}

model Shot {
  id                 String     @id @default(cuid())
  sceneId            String
  shotNumber         Int
  shotType           String
  duration           Float      @default(3.0)
  generatedVideoPath String?
  storageBackend     String     @default("local")
  storagePath        String?
  thumbnailPath      String?
  status             ShotStatus @default(DRAFT)
  approvedVariantIndex Int      @default(0)
  variantPaths         String?  @db.Text
  variantCount         Int      @default(1)

  // Prompt used for generation
  prompt String? @db.Text

  // Likeness compliance check
  likenessChecked     Boolean  @default(false)
  likenessCheckPassed Boolean?
  likenessMatchedName String? // name of person flagged (if any)
  likenessScore       Float? // similarity score 0–1
  flaggedReason       String?  @db.Text

  // Cost tracking per shot
  generationCostUsd Float?

  // Audio pipeline (Phase 6)
  mixedAudioPath     String? // R2 key: full dialogue+music mix
  dialogueStemPath   String? // R2 key: dialogue-only stem
  musicStemPath      String? // R2 key: music-only stem (under this shot)
  lipSyncedVideoPath String? // R2 key: lip-synced version
  lipSyncStatus      String? // PENDING | COMPLETE | FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene         Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  dialogueLines DialogueLine[]
}

model NarratorProfile {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceId          String?
  voiceName        String?
  gender           String?
  pace             String   @default("measured")
  tone             String?
  emotionalRange   String   @default("medium")
  deliveryStyle    String?
  previewAudioPath String?
  pauseSeconds     Float    @default(2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model VisualSegment {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stanzaIndex        Int
  stanzaText         String   @db.Text
  visualConcept      String   @db.Text
  primarySubject     String
  movementStyle      String
  cameraApproach     String
  colorTemperature   String
  emotionalQuality   String?
  additionalNotes    String?  @db.Text
  generationPrompt   String?  @db.Text
  generatedVideoPath String?
  approvedVariantIdx Int      @default(0)
  variantPaths       String?  @db.Text
  narratorAudioPath  String?
  durationSeconds    Float?
  sortOrder          Int
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  previews           ScenePreview[]

  @@index([projectId])
  @@index([projectId, sortOrder])
}

model ScenePreview {
  id                   String         @id @default(cuid())
  sceneId              String?
  scene                Scene?         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  visualSegmentId      String?
  visualSegment        VisualSegment? @relation(fields: [visualSegmentId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testMode             String
  status               String         @default("generating")
  shotsGenerated       Int            @default(0)
  totalShots           Int            @default(1)
  previewVideoPath     String?
  previewThumbPath     String?
  generationPromptUsed String?        @db.Text
  themeModifierUsed    String?        @db.Text
  costActual           Float          @default(0)
  durationSeconds      Float?
  approvedAt           DateTime?
  feedback             String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([sceneId])
  @@index([visualSegmentId])
  @@index([projectId, createdAt])
}

model ProjectMusicTrack {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mood             String?
  tempo            String?
  style            String?
  primaryInstrument String?
  silenceUsage     String?
  emotionalArc     String?  @db.Text
  audioPath        String?
  durationSeconds  Float?
  generationPrompt String?  @db.Text
  status           String   @default("pending")
  createdAt        DateTime @default(now())
}

model RunwayClip {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clipId            String
  sceneIndex        Int
  clipIndex         Int
  durationSeconds   Int
  runwayTaskId      String?
  status            String   @default("queued")
  videoPath         String?
  muxedVideoPath    String?
  audioPath         String?
  startImagePath    String
  endImagePath      String
  queuePosition     Int?
  submittedAt       DateTime?
  generationStart   DateTime?
  generationEnd     DateTime?
  downloadEnd       DateTime?
  muxEnd            DateTime?
  completedAt       DateTime?
  costUsd           Float?
  errorMessage      String?
  retryCount        Int      @default(0)
  runwayPollCount   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, clipId])
  @@index([projectId, sceneIndex])
}

model AssembledVideo {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoPath   String
  durationSec Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model GenerationJob {
  id                    String           @id @default(cuid())
  projectId             String           @unique
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status                String           @default("queued")
  startedAt             DateTime?
  completedAt           DateTime?
  pausedAt              DateTime?
  isPauseRequested      Boolean          @default(false)
  estimatedTotalSeconds Int?
  totalCostEstimate     Float            @default(0)
  totalCostActual       Float            @default(0)
  overallProgress       Float            @default(0)
  currentStageLabel     String?
  completedTaskIds      String?          @db.Text
  tasks                 GenerationTask[]
  logs                  GenerationLog[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model GenerationTask {
  id              String           @id @default(cuid())
  jobId           String
  job             GenerationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parentTaskId    String?
  parent          GenerationTask?  @relation("TaskChildren", fields: [parentTaskId], references: [id])
  children        GenerationTask[] @relation("TaskChildren")
  taskType        String
  label           String
  status          String           @default("pending")
  progress        Float            @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  durationSeconds Float?
  costActual      Float            @default(0)
  errorMessage    String?
  retryCount      Int              @default(0)
  metadata        String?          @db.Text
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([jobId])
  @@index([parentTaskId])
}

model GenerationLog {
  id        String        @id @default(cuid())
  jobId     String
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String        @default("info")
  message   String
  taskId    String?
  metadata  String?       @db.Text
  timestamp DateTime      @default(now())

  @@index([jobId, timestamp])
}

// ─── Phase 6: Audio pipeline models ──────────────────────────────────────────

model DialogueLine {
  id          String  @id @default(cuid())
  shotId      String
  characterId String?
  lineIndex   Int // display order within the shot (0-based)

  text              String  @db.Text
  deliveryDirection String? @db.Text // acting note, e.g. "quietly, with fear"

  // Generated audio
  audioPath    String? // R2 key
  startTimeSec Float? // position in scene timeline
  endTimeSec   Float?
  durationSec  Float?
  status       DialogueStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shot      Shot       @relation(fields: [shotId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id])

  @@index([shotId])
}

// ─── Phase 7: Assembly & Export ───────────────────────────────────────────────

enum ExportPlatform {
  YOUTUBE_SHORTS
  INSTAGRAM_REELS
  TIKTOK
  YOUTUBE_STANDARD
}

enum ExportStatus {
  PENDING
  ASSEMBLING
  COMPLETE
  FAILED
}

model Export {
  id        String         @id @default(cuid())
  projectId String
  platform  ExportPlatform
  status    ExportStatus   @default(PENDING)
  error     String?        @db.Text

  // Output files (R2 keys)
  videoR2Key String? // assembled + encoded video
  pdfR2Key   String? // provenance report PDF

  // Metadata baked at export time
  durationSec         Float?
  fileSizeBytes       Int?
  complianceSnapshot  Json? // snapshot of all compliance checks at export time
  aiDisclosureApplied Boolean   @default(false)
  disclosureTimestamp DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SceneMusicCue {
  id      String @id @default(cuid())
  sceneId String @unique
  assetId String

  startPointSec Float @default(0) // offset into the music track
  fadeInSec     Float @default(2)
  fadeOutSec    Float @default(3)
  volumeDb      Float @default(-12) // attenuation under dialogue

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id])
}

// ─── Phase 9: Captions & Subtitles ───────────────────────────────────────────

model Transcription {
  id        String @id @default(cuid())
  projectId String @unique

  // Whisper response metadata
  language    String? // ISO language code detected by Whisper
  durationSec Float? // total audio duration
  rawResponse Json // full Whisper verbose_json response for re-processing

  // Caption style saved per project
  captionStyle Json? // { fontSize, fontColor, backgroundColor, position, fontFamily }

  segments CaptionSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CaptionSegment {
  id              String @id @default(cuid())
  transcriptionId String
  index           Int // display order (0-based)
  startSec        Float
  endSec          Float
  text            String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transcription Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  @@index([transcriptionId])
}

// ─── Phase 10: Thumbnails ─────────────────────────────────────────────────────

enum ThumbnailVariant {
  IMPACT_FRAME
  CHARACTER_FOCUS
  MOOD_ATMOSPHERE
}

model ProjectThumbnail {
  id        String @id @default(cuid())
  projectId String

  variant    ThumbnailVariant
  isSelected Boolean          @default(false) // only one should be true per project

  // R2 keys for each platform size
  youtubeR2Key String? // 1280×720
  tiktokR2Key  String? // 1080×1920
  squareR2Key  String? // 1080×1080

  // Text overlay settings saved with this variant
  titleText    String?
  fontSize     String  @default("large") // small | medium | large
  textColor    String  @default("white")
  textPosition String  @default("bottom") // bottom | center | top
  textStyle    String  @default("shadow") // plain | bold | shadow | outline

  // Generation metadata
  baseFramePath String? // R2 key of the source extracted frame (Impact Frame only)
  prompt        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─── Phase 11: Social Media Upload ────────────────────────────────────────────

model SocialAccount {
  id                    String    @id @default(cuid())
  platform              String    @unique // youtube | tiktok | instagram
  username              String
  platformUserId        String? // channel ID, open_id, ig_user_id
  encryptedAccessToken  String    @db.Text
  encryptedRefreshToken String?   @db.Text
  tokenExpiresAt        DateTime?
  isConnected           Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model SocialPost {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform       String
  platformPostId String
  postUrl        String
  title          String
  caption        String   @db.Text
  publishedAt    DateTime @default(now())
  status         String   @default("published")

  analytics VideoAnalytics?

  @@index([projectId])
}

// ─── Phase 14: Analytics & Performance Tracking ──────────────────────────────

model VideoAnalytics {
  id                  String     @id @default(cuid())
  socialPostId        String     @unique
  socialPost          SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  platform            String
  fetchedAt           DateTime   @default(now())
  viewCount           Int        @default(0)
  likeCount           Int        @default(0)
  commentCount        Int        @default(0)
  shareCount          Int        @default(0)
  watchTimeSeconds    Int        @default(0)
  impressions         Int        @default(0)
  clickThroughRate    Float?
  averageViewDuration Float?
  retentionRate       Float?

  @@index([platform])
}

model ProjectCost {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider        String // anthropic | runway | elevenlabs | replicate
  jobType         String // script_analysis | video_generation | voice_generation
  tokenCount      Int?
  durationSeconds Int?
  cost            Float
  recordedAt      DateTime @default(now())

  @@index([projectId])
  @@index([provider])
}

// ─── Phase 13: Template & Style Library ──────────────────────────────────────

model Template {
  id               String   @id @default(cuid())
  name             String
  description      String   @db.Text
  genre            String
  tone             String
  visualStyle      String
  audioStyle       String
  targetPlatform   String
  targetLength     String
  isBuiltIn        Boolean  @default(false)
  usageCount       Int      @default(0)
  sourceProjectId  String?
  thumbnailPath    String?
  characterConfig  String?  @db.Text // JSON array of character stubs
  musicConfig      String?  @db.Text // JSON: music cue preferences
  generationConfig String?  @db.Text // JSON: visual generation settings
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Phase 15: Theme Creation System ─────────────────────────────────────────

model Theme {
  id                     String   @id @default(cuid())
  name                   String
  description            String?  @db.Text
  sourceUrl              String?
  sourcePlatform         String? // youtube | instagram | facebook | manual
  referenceFramePaths    String?  @db.Text // JSON array of local frame paths
  coverFrameIndex        Int      @default(0)
  colorPalette           String? // JSON array of hex strings
  colorMood              String?
  colorTemperature       String? // cool | neutral | warm
  saturation             String? // desaturated | muted | normal | vivid
  contrast               String? // low | medium | high
  genre                  String?
  tone                   String?
  visualStyle            String?
  audioStyle             String?
  lightingStyle          String?
  cameraMovement         String?
  dominantShotTypes      String? // JSON array
  pacing                 String?
  avgShotDurationSeconds Float?
  characterAgeRange      String?
  characterAppearance    String?  @db.Text
  characterMood          String?
  primaryEnvironment     String?
  timeOfDay              String? // JSON array
  environmentDescription String?  @db.Text
  musicGenre             String?
  musicMood              String?
  musicTempo             String?
  audioNotes             String?  @db.Text
  visualPromptModifier   String?  @db.Text
  audioPromptModifier    String?  @db.Text
  cinematographyNotes    String?  @db.Text
  analysisRawJson        String?  @db.Text
  usageCount             Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  projectsUsingTheme  Project[]
  sceneOverrides      Scene[]
  generatedCharacters Character[]
}

// ─── Phase 12: Project Version History ───────────────────────────────────────

model ProjectVersion {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber  Int
  label          String
  scriptSnapshot String   @db.Text
  configSnapshot String   @db.Text // JSON: { name, platform, status }
  createdAt      DateTime @default(now())
  createdBy      String   @default("user")

  @@index([projectId])
}
