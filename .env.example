# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clippilot"

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ─── Anthropic (claude.ai/api) ───────────────────────────────────────────────
# Used for: Script analysis, scene planning, metadata generation, script writing
ANTHROPIC_API_KEY=

# ─── Runway ML (runwayml.com) ─────────────────────────────────────────────────
# Used for: Generating video clips from shot descriptions (Gen-3 Alpha Turbo)
RUNWAYML_API_SECRET=

# ─── Replicate (replicate.com) ───────────────────────────────────────────────
# Used for: Image generation and video generation fallback (zeroscope-v2-xl)
REPLICATE_API_TOKEN=

# ─── ElevenLabs (elevenlabs.io) ──────────────────────────────────────────────
# Used for: Generating character voices and dialogue audio
ELEVENLABS_API_KEY=

# ─── Mubert (mubert.com) ─────────────────────────────────────────────────────
# Used for: AI music generation for scene underscore.
# Use either the service pair Mubert gives your company:
MUBERT_COMPANY_ID=
MUBERT_LICENSE_TOKEN=
# Or a public customer pair created from that service account:
MUBERT_CUSTOMER_ID=
MUBERT_ACCESS_TOKEN=
# Optional custom user id when deriving customer credentials from service keys.
MUBERT_CUSTOM_ID=clippilot-local

# ─── AudD music recognition (audd.io) ────────────────────────────────────────
# Used for: Music Content ID fingerprint pre-check before using any track
AUDD_API_TOKEN=

# ─── OpenAI (openai.com) ─────────────────────────────────────────────────────
# Used for: Whisper transcription to generate captions from the final audio mix
OPENAI_API_KEY=

# ─── Sync Labs lip sync (synclabs.so) ────────────────────────────────────────
# Used for: Lip sync alignment — matching mouth movement to dialogue
# When absent, lip sync is skipped and the pipeline continues without it.
SYNCLABS_API_KEY=

# ─── Cloudflare R2 storage ───────────────────────────────────────────────────
# Used for: Storing all generated video clips, audio files, and exports
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clippilot
R2_PUBLIC_URL=https://YOUR_BUCKET.r2.dev

# ─── Local storage fallback ──────────────────────────────────────────────────
# Used when R2 is not fully configured. Can also be set in Settings -> Storage.
LOCAL_STORAGE_PATH=./generated-media
USE_LOCAL_STORAGE=true

# ─── Likeness Compliance Check (AWS Rekognition) ─────────────────────────────
# Set LIKENESS_CHECK_ENABLED=true to activate.
LIKENESS_CHECK_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── FFmpeg (audio mix + assembly) ───────────────────────────────────────────
# fluent-ffmpeg auto-detects ffmpeg from PATH.
# Override only if ffmpeg is not on PATH.
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# ─── Encryption ──────────────────────────────────────────────────────────────
# Required for encrypting API keys stored in the database.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Never share or commit this value.
ENCRYPTION_SECRET=

# ─── Social Media OAuth ───────────────────────────────────────────────────────

# YouTube (Google OAuth 2.0)
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Enable: YouTube Data API v3
# Scopes: https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly
# Authorized redirect URI: http://localhost:3000/api/auth/callback/youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers
# Get from: developers.tiktok.com → Manage Apps → Create App
# Scopes: video.upload, video.publish, user.info.basic
# Authorized redirect URI: http://localhost:3000/api/auth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram / Meta for Developers
# Get from: developers.facebook.com → My Apps → Create App → Add Instagram Product
# Scopes: instagram_basic, instagram_content_publish
# Authorized redirect URI: http://localhost:3000/api/auth/callback/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
